{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: splash, remote game page, stats and translate commands",
  "windows": ["main"],
  "remote": {
    "urls": ["https://speakirpg.overture.io.kr/*"]
  },
  "permissions": [
    "core:default",
    "allow-update-stats",
    "allow-translate-text",
    "allow-open-settings",
    "allow-get-user-mod-scripts",
    "allow-take-account-switch-pending"
  ]
}
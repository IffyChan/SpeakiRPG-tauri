{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "settings-window",
    "description": "Local settings window: read/write settings, open the mods folder",
    "windows": ["settings"],
    "permissions": [
      "core:default",
      "allow-get-settings",
      "allow-set-settings",
      "allow-open-mods-folder"
    ]
  }